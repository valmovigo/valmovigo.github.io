  {
    "@id": "https://www.perceptrum.net/augmented-painting/augmented-painting.ttl#AugmentedPainting",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "\n    An art form that combines a physical painted surface with embedded sensing technologies,\n    artificial intelligence, and machine learning, enabling interactive, adaptive,\n    and networked experiences where touch and visual interaction generate evolving behaviors.\n    \n    Essential properties:\n    - physical painted surface\n    - interaction\n    - memory\n    - adaptation\n    - machine learning\n    - network communication (optional but supported)\n    \n    Sound generation is NOT mandatory.\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Augmented Painting"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
