  <rdf:Description rdf:about="https://www.perceptrum.net/augmented-painting/augmented-painting.ttl#AugmentedPainting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.perceptrum.net/augmented-painting/augmented-painting.ttl#AugmentedPhysicalObject"/>
    <rdfs:label>Augmented Painting</rdfs:label>
    <rdfs:comment>
    An art form that combines a physical painted surface with embedded sensing technologies,
    artificial intelligence, and machine learning, enabling interactive, adaptive,
    and networked experiences where touch and visual interaction generate evolving behaviors.
    
    Essential properties:
    - physical painted surface
    - interaction
    - memory
    - adaptation
    - machine learning
    - network communication (optional but supported)
    
    Sound generation is NOT mandatory.
    </rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.perceptrum.net/ontology/augmented-painting.html"/>
    <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q137104541"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.perceptrum.net/augmented-painting/augmented-painting.ttl#AugmentedPhysicalObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Augmented Physical Object</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://www.wikidata.org/wiki/Q138713278"/>
  </rdf:Description>
